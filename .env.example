PORT=3000
TELEGRAM_BOT_TOKEN= 
# Bitta kalit ishlatmoqchi bo'lsangiz shu yetarli:
GEMINI_API_KEY=sizning_gemini_api_keyingiz
# Ixtiyoriy (tavsiya etiladi): bir nechta MUSTAQIL Google Cloud loyihadan
# olingan kalitlarni vergul bilan ajratib yozing — tizim ular orasida
# avtomatik almashadi (round-robin), shunda bepul limit ko'payadi.
# Muhim: har bir kalit ALOHIDA loyihada bo'lishi shart, aks holda limit
# baribir birlashadi. Bo'sh qoldirilsa, yuqoridagi GEMINI_API_KEY ishlatiladi.
GEMINI_API_KEYS=kalit1,kalit2,kalit3
# Ixtiyoriy: bo'sh qoldirilsa "gemini-flash-latest" ishlatiladi
GEMINI_MODEL=gemini-flash-latest
# Ixtiyoriy zaxira provayder: barcha Gemini kalitlar bir vaqtda limitga
# uchrasa, so'rov shu yerga (OpenRouter, bepul model) yo'naltiriladi.
# https://openrouter.ai dan bepul ro'yxatdan o'tib olinadi.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat:free
REDIS_URL=redis://localhost:6379
# Ixtiyoriy: https://unsplash.com/developers dan bepul olinadi.
# Bo'sh qoldirilsa, har doim bitta neytral fallback rasm ishlatiladi
# (kalitsiz ham bot ishlayveradi, faqat rasmlar mavzuga mos bo'lmaydi).
UNSPLASH_ACCESS_KEY=